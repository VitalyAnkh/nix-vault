Backport V8 65ce14d8731e929584344a0d65d6efd2296fa797 to Node.js 24.16.0.

Upstream: https://github.com/v8/v8/commit/65ce14d8731e929584344a0d65d6efd2296fa797
Bug: https://issues.chromium.org/issues/424006386

Remove V8's generic std::hash partial specialization, which can violate
ODR for non-V8 types and break Node's worker file-descriptor bookkeeping
when built with libc++ 21. Use base::hash explicitly for Wasm canonical
recursion groups, as in the upstream change.

Backport note: omit the upstream profile-generator.h hunk. Node 24.16.0
still uses unordered_map<int, int> line_ticks_, not the newer map keyed
by pair<int, int>; the standard integer hash is sufficient there.

diff --git a/deps/v8/src/base/hashing.h b/deps/v8/src/base/hashing.h
--- a/deps/v8/src/base/hashing.h
+++ b/deps/v8/src/base/hashing.h
@@ -360,12 +360,4 @@
 
 }  // namespace v8::base
 
-// Also define std::hash for all classes that can be hashed via v8::base::hash.
-namespace std {
-template <typename T>
-  requires requires { typename v8::base::hash<T>; }
-struct hash<T> : v8::base::hash<T> {};
-
-}  // namespace std
-
 #endif  // V8_BASE_HASHING_H_
diff --git a/deps/v8/src/wasm/canonical-types.h b/deps/v8/src/wasm/canonical-types.h
--- a/deps/v8/src/wasm/canonical-types.h
+++ b/deps/v8/src/wasm/canonical-types.h
@@ -557,9 +557,12 @@
 
   std::vector<CanonicalTypeIndex> canonical_supertypes_;
   // Set of all known canonical recgroups of size >=2.
-  std::unordered_set<CanonicalGroup> canonical_groups_;
+  std::unordered_set<CanonicalGroup, base::hash<CanonicalGroup>>
+      canonical_groups_;
   // Set of all known canonical recgroups of size 1.
-  std::unordered_set<CanonicalSingletonGroup> canonical_singleton_groups_;
+  std::unordered_set<CanonicalSingletonGroup,
+                     base::hash<CanonicalSingletonGroup>>
+      canonical_singleton_groups_;
   // Maps canonical indices back to the types.
   CanonicalTypeVector canonical_types_;
   AccountingAllocator allocator_;
