    },
    {
      "description": "Nix Vault: All profiles: Emacs global hotkey",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "q",
            "modifiers": {
              "mandatory": ["control", "shift"],
              "optional": ["caps_lock"]
            }
          },
          "to": [
            {
              "key_code": "h",
              "modifiers": ["left_command"],
              "repeat": false
            }
          ],
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": ["^org\\.gnu\\.Emacs$"]
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "q",
            "modifiers": {
              "mandatory": ["control", "shift"],
              "optional": ["caps_lock"]
            }
          },
          "to": [
            {
              "software_function": {
                "open_application": {
                  "file_path": "~/Applications/Home Manager Apps/Emacs.app"
                }
              }
            }
          ]
        }
      ]
    }
  ]
