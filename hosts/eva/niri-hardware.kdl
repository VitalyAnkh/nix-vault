// Host-local Niri output/workspace overrides for eva.
//
// This file is only consumed when starting Niri. The current eva desktop path
// remains GDM + GNOME.
// Connector information was captured from GNOME/Mutter DisplayConfig on eva.

output "DP-3" {
    scale 2.0
    transform "normal"
    position x=0 y=0
}

workspace "1terminal" { open-on-output "DP-3"; }
workspace "2browser" { open-on-output "DP-3"; }
workspace "3chat" { open-on-output "DP-3"; }
workspace "4entertainment" { open-on-output "DP-3"; }
workspace "5utility" { open-on-output "DP-3"; }
workspace "0other" { open-on-output "DP-3"; }
